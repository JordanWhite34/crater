# Dataset artifacts are ignored by default.
# Track documentation and manifests, plus explicit versioned source datasets.
/datasets/**
!/datasets/**/
!/datasets/**/README.md
!/datasets/**/source_manifest.csv
!/datasets/military/components/source/humvee/*.jpg
!/datasets/military/components/source/humvee/*.png
!/datasets/military/components/source/humvee/instances_default.json
!/datasets/military/damage/source/humvee_cvat_damage_v1/annotations.xml
!/datasets/military/damage/source/humvee_cvat_damage_v1/damage_box_annotations.csv
!/datasets/military/damage/source/humvee_cvat_damage_v1/import_manifest.json
!/datasets/military/damage/source/synthetic_humvee_damage_v1/annotations.xml
!/datasets/military/damage/source/synthetic_humvee_damage_v1/damage_box_annotations.csv
!/datasets/military/damage/source/synthetic_humvee_damage_v1/import_manifest.json
!/datasets/military/damage/source/synthetic_humvee_damage_v1/images/
!/datasets/military/damage/source/synthetic_humvee_damage_v1/images/*.png
!/datasets/military/damage/source/synthetic_humvee_additions_v2/README.md
!/datasets/military/damage/source/synthetic_humvee_additions_v2/annotations.xml
!/datasets/military/damage/source/synthetic_humvee_additions_v2/damage_box_annotations.csv
!/datasets/military/damage/source/synthetic_humvee_additions_v2/import_manifest.json
!/datasets/military/damage/source/synthetic_humvee_additions_v2/source_manifest.csv
!/datasets/military/damage/source/synthetic_humvee_additions_v2/images/
!/datasets/military/damage/source/synthetic_humvee_additions_v2/images/*.png

# Model inputs and generated training artifacts.
/weights/
/outputs/
/runs/
/tmp/
cache_*/

# Python-generated files and local environments.
__pycache__/
.ipynb_checkpoints/
*.py[cod]
.venv/
venv/
env/

# Local tooling and editor files.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/

# OS metadata.
.DS_Store
Thumbs.db
